{
  "$schema": "https://opencode.ai/config.json",
  "model": "kj/gemma4-31b-it",
  "share": "disabled",
  "autoupdate": true,
  "permission": {
      "external_directory": {
          "/tmp/**": "allow"
      },
      "edit": "ask"
  },
  "provider": {
    "kj": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KJ Local",
      "options": {
        "baseURL": "http://kj/llm/v1",
        "apiKey": "{env:KJ_API_KEY}"
      },
      "models": {
        "qwen3.6-27b": {
          "name": "Qwen3.6 27B"
        },
        "gemma4-31b-it": {
          "name": "Gemma 4 31B IT"
        },
        "qwen": {"name": "Qwen"},
        "gemma": {"name": "Gemma"}
      }
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "kj/gemma4-31b-it",
      "options": {
          "enable_thinking": true,
      },
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "build": {
      "mode": "primary",
      "model": "kj/qwen3.6-27b",
      "options": {
          "enable_thinking": true,
      },
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "gemma": {
      "mode": "primary",
      "model": "kj/gemma",
      "options": {
          "enable_thinking": true,
      },
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "qwen": {
      "mode": "primary",
      "model": "kj/qwen",
      "options": {
          "enable_thinking": true,
      },
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
  }
}
